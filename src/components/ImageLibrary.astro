<div class="app-shell">
	<header class="topbar">
		<a class="brand" href="/" aria-label="Study Cards, inicio">
			<span class="brand__mark" aria-hidden="true">
				<svg viewBox="0 0 32 32" fill="none">
					<path d="M9 6.5h13.25A2.75 2.75 0 0 1 25 9.25v16A2.75 2.75 0 0 1 22.25 28H9A2.75 2.75 0 0 1 6.25 25.25v-16A2.75 2.75 0 0 1 9 6.5Z" stroke="currentColor" stroke-width="1.8" />
					<path d="M10.5 12h10m-10 4h7m-7 4h8" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
					<path d="M4.5 9.5v15A2.5 2.5 0 0 0 7 27h12" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" opacity=".55" />
				</svg>
			</span>
			<span class="brand__wordmark">Study<span>Cards</span></span>
		</a>

		<div class="privacy-pill">
			<span class="privacy-pill__dot" aria-hidden="true"></span>
			<span>Privado en este dispositivo</span>
		</div>
	</header>

	<main class="main-content">
		<section class="intro" aria-labelledby="page-title">
			<div class="intro__copy">
				<p class="eyebrow"><span class="eyebrow__line"></span> ESTUDIO VISUAL</p>
				<h1 id="page-title">Tus imágenes,<br />listas para <span>estudiar.</span></h1>
				<p class="intro__description">
					Importa una carpeta y convierte tus apuntes visuales en una biblioteca clara,
					lista para repasar.
				</p>
			</div>

			<aside class="import-panel" aria-labelledby="import-title">
				<div class="import-panel__heading">
					<span class="import-panel__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none">
							<path d="M3.5 7.75A2.25 2.25 0 0 1 5.75 5.5h4.1l2 2h6.4A2.25 2.25 0 0 1 20.5 9.75v7.5a2.25 2.25 0 0 1-2.25 2.25h-12A2.75 2.75 0 0 1 3.5 16.75v-9Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7" />
							<path d="M12 11v5m-2-2 2 2 2-2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" />
						</svg>
					</span>
					<div>
						<h2 id="import-title">Importa una carpeta</h2>
						<p>Encontraremos las imágenes por ti.</p>
					</div>
				</div>

				<input
					class="visually-hidden"
					id="folder-picker"
					type="file"
					accept="image/*,.svg"
					webkitdirectory
					directory
					multiple
					aria-label="Selecciona una carpeta con imágenes"
				/>
				<button class="import-button" id="choose-folder" type="button" aria-controls="cards-grid">
					<span>Seleccionar carpeta</span>
					<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<path d="M10 13V3m0 0L6.5 6.5M10 3l3.5 3.5M4 12.5v3A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5v-3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" />
					</svg>
				</button>
				<p class="import-panel__hint">JPG, PNG, GIF, WebP, SVG, AVIF y otros formatos de imagen</p>
			</aside>
		</section>

		<section class="library" aria-labelledby="library-title">
			<div class="library__heading">
				<div>
					<p class="eyebrow eyebrow--muted">TU ESPACIO</p>
					<h2 id="library-title">Biblioteca <span>visual</span></h2>
				</div>
				<div class="library__meta" id="library-meta" hidden>
					<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<path d="M2.5 6.25A1.75 1.75 0 0 1 4.25 4.5h3.2l1.6 1.6h6.7a1.75 1.75 0 0 1 1.75 1.75v6.9a1.75 1.75 0 0 1-1.75 1.75h-11a2.25 2.25 0 0 1-2.25-2.25v-8Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5" />
					</svg>
					<span id="folder-name"></span>
					<span class="library__meta-divider" aria-hidden="true"></span>
					<strong id="image-count"></strong>
				</div>
			</div>

			<p class="visually-hidden" id="library-status" role="status" aria-live="polite"></p>

			<div class="empty-state" id="empty-state">
				<div class="empty-state__art" aria-hidden="true">
					<div class="empty-state__card empty-state__card--back"><span></span><i></i></div>
					<div class="empty-state__card empty-state__card--front">
						<svg viewBox="0 0 36 36" fill="none">
							<rect x="5.5" y="7.5" width="25" height="21" rx="4" stroke="currentColor" stroke-width="1.7" />
							<circle cx="13" cy="14.5" r="2.5" stroke="currentColor" stroke-width="1.7" />
							<path d="m8 25 7-6 4 3 3-2 6 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" />
						</svg>
					</div>
				</div>
				<h3 id="empty-title">Aquí empieza tu colección</h3>
				<p id="empty-description">Selecciona una carpeta de tu equipo para ver tus imágenes como tarjetas.</p>
			</div>

			<div class="image-grid" id="cards-grid" role="list" aria-label="Tarjetas de imágenes" hidden></div>
		</section>
	</main>

	<footer class="page-footer">
		<p>
			<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
				<path d="M10 2.5 4 5v4.2c0 3.8 2.55 6.9 6 8.3 3.45-1.4 6-4.5 6-8.3V5l-6-2.5Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5" />
				<path d="m7.5 9.75 1.7 1.7 3.5-3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
			</svg>
			Tus archivos se leen localmente y no se suben a internet.
		</p>
		<span>STUDY CARDS <i>·</i> HECHO PARA APRENDER</span>
	</footer>
</div>

<script>
	const folderPicker = document.querySelector<HTMLInputElement>('#folder-picker');
	const chooseFolderButton = document.querySelector<HTMLButtonElement>('#choose-folder');
	const cardsGrid = document.querySelector<HTMLDivElement>('#cards-grid');
	const emptyState = document.querySelector<HTMLDivElement>('#empty-state');
	const emptyTitle = document.querySelector<HTMLHeadingElement>('#empty-title');
	const emptyDescription = document.querySelector<HTMLParagraphElement>('#empty-description');
	const libraryMeta = document.querySelector<HTMLDivElement>('#library-meta');
	const folderNameLabel = document.querySelector<HTMLSpanElement>('#folder-name');
	const imageCountLabel = document.querySelector<HTMLElement>('#image-count');
	const libraryStatus = document.querySelector<HTMLParagraphElement>('#library-status');
	const previewUrls: string[] = [];

	const supportedImageExtension = /\.(avif|bmp|gif|jpe?g|png|svg|tiff?)$/i;

	function getImageTitle(filename: string) {
		const extensionIndex = filename.lastIndexOf('.');
		return extensionIndex > 0 ? filename.slice(0, extensionIndex) : filename;
	}

	function getImageExtension(filename: string) {
		const extension = filename.match(/\.([^.]+)$/)?.[1];
		return extension ? extension.toUpperCase() : 'IMG';
	}

	function formatImageCount(count: number) {
		return `${count} ${count === 1 ? 'imagen' : 'imágenes'}`;
	}

	function clearCards() {
		previewUrls.forEach((url) => URL.revokeObjectURL(url));
		previewUrls.length = 0;
		cardsGrid?.replaceChildren();
	}

	function makeImageCard(file: File) {
		const title = getImageTitle(file.name);
		const imageUrl = URL.createObjectURL(file);
		previewUrls.push(imageUrl);

		const card = document.createElement('article');
		card.className = 'image-card';
		card.setAttribute('role', 'listitem');

		const preview = document.createElement('div');
		preview.className = 'image-card__preview';

		const image = document.createElement('img');
		image.src = imageUrl;
		image.alt = title;
		image.loading = 'lazy';
		image.decoding = 'async';
		image.addEventListener('error', () => {
			const fallback = document.createElement('span');
			fallback.className = 'image-card__fallback';
			fallback.textContent = 'Vista previa no disponible en este navegador';
			image.replaceWith(fallback);
		}, { once: true });

		const format = document.createElement('span');
		format.className = 'image-card__format';
		format.textContent = getImageExtension(file.name);
		preview.append(image, format);

		const details = document.createElement('div');
		details.className = 'image-card__details';

		const heading = document.createElement('h3');
		heading.className = 'image-card__title';
		heading.textContent = title;
		heading.title = title;
		details.append(heading);

		card.append(preview, details);

		const pathParts = file.webkitRelativePath.split('/');
		const nestedFolder = pathParts.length > 2 ? pathParts.slice(1, -1).join(' / ') : '';
		if (nestedFolder) {
			const path = document.createElement('p');
			path.className = 'image-card__path';
			path.textContent = nestedFolder;
			card.append(path);
		}

		return card;
	}

	function handleFolderSelection(files: File[]) {
		if (!cardsGrid || !emptyState || !emptyTitle || !emptyDescription || !libraryMeta || !folderNameLabel || !imageCountLabel || !libraryStatus) {
			return;
		}

		clearCards();

		const imageFiles = files
			.filter((file) => file.type.startsWith('image/') || supportedImageExtension.test(file.name))
			.sort((first, second) => {
				const firstPath = first.webkitRelativePath || first.name;
				const secondPath = second.webkitRelativePath || second.name;
				return firstPath.localeCompare(secondPath, undefined, { numeric: true, sensitivity: 'base' });
			});

		const firstPath = files[0]?.webkitRelativePath || '';
		const folderName = firstPath.split(/[\\/]/)[0] || 'Carpeta seleccionada';
		folderNameLabel.textContent = folderName;
		imageCountLabel.textContent = formatImageCount(imageFiles.length);
		libraryMeta.hidden = false;

		if (imageFiles.length === 0) {
			emptyTitle.textContent = 'No encontramos imágenes';
			emptyDescription.textContent = `La carpeta «${folderName}» no contiene archivos de imagen compatibles. Prueba con otra carpeta.`;
			emptyState.hidden = false;
			cardsGrid.hidden = true;
			libraryStatus.textContent = `No encontramos imágenes en la carpeta ${folderName}.`;
			return;
		}

		emptyState.hidden = true;
		cardsGrid.hidden = false;
		const fragment = document.createDocumentFragment();
		imageFiles.forEach((file) => fragment.append(makeImageCard(file)));
		cardsGrid.append(fragment);
		libraryStatus.textContent = `${formatImageCount(imageFiles.length)} importadas desde la carpeta ${folderName}.`;
	}

	chooseFolderButton?.addEventListener('click', () => folderPicker?.click());
	folderPicker?.addEventListener('change', () => {
		const files = Array.from(folderPicker.files ?? []);
		folderPicker.value = '';
		handleFolderSelection(files);
	});

	window.addEventListener('beforeunload', () => {
		previewUrls.forEach((url) => URL.revokeObjectURL(url));
	});
</script>
